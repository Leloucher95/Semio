# Aucun secret réel ici.
APP_ENV=development
APP_URL=http://localhost:5173
PB_LISTEN=127.0.0.1:8090
PB_DATA_DIR=./pb_data
DEFAULT_TIMEZONE=Africa/Porto-Novo

# À configurer sur le VPS de production avant lancement public.
R2_ACCOUNT_ID=
R2_BACKUPS_BUCKET=semio-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
R2_FORCE_PATH_STYLE=true
BACKUP_CRON=0 2 * * *
BACKUP_KEEP=14

# Facultatif si réinitialisation de mot de passe activée.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
